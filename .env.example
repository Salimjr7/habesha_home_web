# ============================================================================
# Habesha Home — Environment Configuration
# ============================================================================

# Database (Neon PostgreSQL)
# Pooled connection string for application runtime (Serverless safe)
DATABASE_URL="postgresql://neondb_owner:npg_sample_pass@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Direct connection string for Prisma CLI migrations & seeding
DIRECT_URL="postgresql://neondb_owner:npg_sample_pass@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Next.js App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Better Auth Secret (Generate using `openssl rand -base64 32`)
BETTER_AUTH_SECRET="habesha-home-super-secret-key-32-chars-minimum"
BETTER_AUTH_URL="http://localhost:3000"

# Chapa Payment Gateway (Ethiopia)
# Get keys at https://dashboard.chapa.co
CHAPA_PUBLIC_KEY="CHAPUBK_TEST-sample_public_key"
CHAPA_SECRET_KEY="CHASECK_TEST-sample_secret_key"
CHAPA_WEBHOOK_SECRET="sample_webhook_secret"

# telebirr Direct Mobile Money (Ethio Telecom)
TELEBIRR_APP_ID="sample_telebirr_app_id"
TELEBIRR_APP_KEY="sample_telebirr_app_key"
TELEBIRR_SHORT_CODE="123456"
TELEBIRR_PUBLIC_KEY="sample_telebirr_public_key"

# Image Storage Provider (Optional: "local" or "cloudinary")
STORAGE_PROVIDER="local"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Transactional Email (Optional: Resend)
RESEND_API_KEY=""
